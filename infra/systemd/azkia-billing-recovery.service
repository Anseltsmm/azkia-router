[Unit]
Description=Azkia Router Billing Recovery
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/azkia-router/gateway
EnvironmentFile=/home/ubuntu/azkia-router/gateway/.env
ExecStart=/home/ubuntu/azkia-router/gateway/.venv/bin/python -m app.billing_worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/azkia-router
